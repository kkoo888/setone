{
  "id": "live2d-5",
  "name": "Live2D Cubism 5",
  "version": "1.1.0",
  "description": "基于 Cubism 5 SDK 的 Live2D 模块，原生 WebGL 渲染，不依赖 pixi.js",
  "author": "小茜",
  "enabled": true,
  "dependencies": [],
  "hostVersion": ">=1.0.0",
  "priority": 20,
  "resourceLimits": {
    "maxMemoryMB": 256,
    "maxCpuPercent": 15
  },
  "provides": [
    {
      "type": "tool",
      "name": "live2d5_open",
      "description": "打开 Live2D 5 桌面宠物窗口",
      "priority": 10
    },
    {
      "type": "tool",
      "name": "live2d5_close",
      "description": "关闭 Live2D 5 桌面宠物窗口",
      "priority": 10
    },
    {
      "type": "tool",
      "name": "live2d5_expression",
      "description": "切换 Live2D 5 表情",
      "priority": 10
    },
    {
      "type": "tool",
      "name": "live2d5_motion",
      "description": "播放 Live2D 5 动作",
      "priority": 10
    }
  ],
  "consumes": []
}
