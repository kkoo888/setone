{
  "id": "file",
  "name": "文件操作",
  "version": "1.0.0",
  "description": "文件读写、目录监听、代码高亮预览",
  "author": "system",
  "enabled": true,
  "dependencies": [],
  "hostVersion": ">=1.0.0",
  "priority": 15,
  "resourceLimits": { "maxMemoryMB": 256, "maxCpuPercent": 10 },
  "provides": [
    { "type": "tool", "name": "file_read", "description": "读取文件内容", "priority": 10 },
    { "type": "tool", "name": "file_write", "description": "写入文件内容", "priority": 10 },
    { "type": "tool", "name": "file_list", "description": "列出目录文件", "priority": 10 },
    { "type": "tool", "name": "file_watch", "description": "监听文件变化", "priority": 10 }
  ],
  "consumes": [],
  "settings": { "allowedExtensions": [".ts", ".tsx", ".js", ".jsx", ".json", ".md", ".css", ".html", ".py", ".go", ".rs"], "maxFileSizeMB": 50 }
}
