{
  "id": "memory",
  "name": "记忆系统",
  "version": "1.0.0",
  "description": "短期/长期记忆，持久化存储和语义检索",
  "author": "system",
  "enabled": true,
  "dependencies": [],
  "hostVersion": ">=1.0.0",
  "priority": 10,
  "resourceLimits": { "maxMemoryMB": 512, "maxCpuPercent": 15 },
  "provides": [
    { "type": "tool", "name": "memory_save", "description": "保存一条记忆", "priority": 10 },
    { "type": "tool", "name": "memory_search", "description": "搜索记忆", "priority": 10 },
    { "type": "tool", "name": "memory_delete", "description": "删除记忆", "priority": 10 }
  ],
  "consumes": [],
  "settings": { "shortTermMaxItems": 100, "longTermMaxItems": 10000, "summarizeThreshold": 50 }
}
