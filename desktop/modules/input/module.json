{
  "id": "input",
  "name": "鼠标键盘控制",
  "version": "1.0.0",
  "description": "鼠标移动/点击、键盘输入/快捷键操作",
  "author": "system",
  "enabled": true,
  "dependencies": [],
  "hostVersion": ">=1.0.0",
  "priority": 20,
  "resourceLimits": { "maxMemoryMB": 64, "maxCpuPercent": 5 },
  "provides": [
    { "type": "tool", "name": "mouse_move", "description": "移动鼠标", "priority": 10 },
    { "type": "tool", "name": "mouse_click", "description": "点击鼠标", "priority": 10 },
    { "type": "tool", "name": "keyboard_type", "description": "键盘输入", "priority": 10 },
    { "type": "tool", "name": "keyboard_shortcut", "description": "执行快捷键", "priority": 10 }
  ],
  "consumes": [],
  "settings": { "moveSpeed": 100, "clickDelay": 50 }
}
