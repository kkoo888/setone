      "--destructive": "#CC3333",
      "--destructive-fg": "#FFFFFF",
      "--success": "#558B2F",
      "--success-fg": "#FFFFFF",
      "--warning": "#BF8C00",
      "--warning-fg": "#333333",
      "--info": "#555555",
      "--info-fg": "#FFFFFF",
      "--border": "#E5E5E5",
      "--ring": "#666666",
      "--sidebar-bg": "#F5F5F5",
      "--sidebar-accent": "#EEEEEE",
