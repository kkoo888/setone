{
  "name": "smart-desktop-assistant",
  "version": "0.1.0",
  "type": "module",
  "description": "智能桌面助手",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "node scripts/clean.js && node scripts/build-modules.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo \"[WARN] electron-rebuild failed, native modules may not work. Install Python 3 + VS Build Tools to fix.\"",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:modules": "node scripts/build-modules.mjs",
    "package": "npm run build && npx electron-builder --win --dir",
    "package:installer": "npm run build && npx electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "live2d-easy-control": "^1.0.3",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "^7.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@playwright/test": "1.60.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vercel/ncc": "^0.38.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^39.8.10",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vite": "^7.3.3",
    "vitest": "4.1.6"
  }
}
